<h1>投稿一覧</h1>

<h2>投稿検索</h2>
<%= search_form_for @q do |f| %>
  <div class="search-form-group">
    <%= f.label :title_cont, "タイトル" %>
    <%= f.search_field :title_cont %>
  </div>
  <div class="search-form-group">
    <%= f.label :content_cont, "投稿内容" %>
    <%= f.search_field :content_cont %>
  </div>
  <%= f.submit "検索" %>
<% end %>

<h2>一覧</h2>
<table class="data-table">
  <thead>
    <tr>
      <th>タイトル</th>
      <th>投稿内容</th>
      <th style="border: none; background: none;"></th>
    </tr>
  </thead>
  <tbody>
    <% @posts.each do |post| %>
      <tr>
        <td><%= post.title %></td>
        <td><%= post.content %></td>
        <td class="action-cell"><%= link_to "投稿詳細", post_path(post) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
