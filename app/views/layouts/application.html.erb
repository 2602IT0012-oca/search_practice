<body>
  <header class="navbar">
    <ul class="navbar-list">
      <% if logged_in? %>
        <li><%= link_to '新規投稿', new_post_path %></li>
        <li><%= link_to 'ユーザー一覧', mypages_path %></li>
        <li><%= link_to '投稿一覧', posts_path %></li>
        <li><%= button_to 'ログアウト', logout_path, method: :delete %></li>
      <% else %>
        <li><%= link_to 'サインアップ', signup_path %></li>
        <li><%= link_to 'ログイン', login_path %></li>
      <% end %>
    </ul>
  </header>

  <main class="container">
    <% if notice %><p style="color: green;"><%= notice %></p><% end %>
    <% if alert %><p style="color: red;"><%= alert %></p><% end %>

    <%= yield %>
  </main>
</body>
