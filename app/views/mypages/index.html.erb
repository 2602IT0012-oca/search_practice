<h2>ユーザー一覧</h2>

<h3>ユーザー検索</h3>
<%= search_form_for @q, url: mypages_path do |f| %>
  <div class="search-form-group">
    <%= f.label :name_cont, '名前', class: 'short-label' %>
    <%= f.search_field :name_cont %>
  </div>
  <div>
    <%= f.submit '検索' %>
  </div>
<% end %>

<br>

<h3>一覧</h3>
<table class="data-table compact-table">
  <thead>
    <tr>
      <th>名前</th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td class="action-cell"><%= link_to '投稿詳細', mypage_path(user) %></td>
      </tr>
    <% end %>
  </tbody>
</table>
